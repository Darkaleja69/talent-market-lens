# Plantilla de secretos para linkedin_jobs_scraper.
# Copia este fichero a .env y rellena los valores:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# NUNCA commitees .env; esta incluido en .gitignore.

# --- Credenciales LinkedIn (login legitimo con tu propia cuenta) ---
LINKEDIN_EMAIL=tu_email@example.com
LINKEDIN_PASS=tu_password

# --- Respaldo Apify (opcional - dejar vacio para desactivar el fallback) ---
# Consigue tu token en https://console.apify.com/account/integrations
APIFY_TOKEN=

# --- Modo navegador ---
# false = ventana visible (recomendado, mas humano, menos bloqueos)
# true  = headless (mas rapido, mas riesgo de bloqueo)
HEADLESS=false