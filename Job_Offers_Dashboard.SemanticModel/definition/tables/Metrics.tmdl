table Metrics
	lineageTag: 1a2b3c4d-5e6f-4a8b-9c0d-1e2f3a4b5c6d

	/// Number of job offers in the selected context (all sources).
	measure 'Total Job Offers' =
			
			VAR MinSeleccionado =
			    SELECTEDVALUE(
			        'Salary Min'[Salary Min],
			        0
			    )
			VAR MaxSeleccionado =
			    SELECTEDVALUE(
			        'Salary Max'[Salary Max],
			        20000000
			    )
			RETURN
			    CALCULATE(
			        COUNTROWS(Fact_Offers),
			        FILTER(
			            Fact_Offers,
			            Fact_Offers[SalaryMaxAnnual_EUR] >= MinSeleccionado
			                && Fact_Offers[SalaryMaxAnnual_EUR] <= MaxSeleccionado
			        )
			    )
		formatString: #,##0
		lineageTag: 10d7607c-764d-42b7-86f6-e6c506f5bc1f

	measure 'Companies Hiring' =
			CALCULATE (
				DISTINCTCOUNT ( 'Fact_Offers'[company_name] ),
				TRIM ( 'Fact_Offers'[company_name] ) <> ""
			)
		formatString: #,##0
		lineageTag: acc4d52a-51b0-427b-8991-e0d53e781d58

	measure 'Countries Hiring' =
			CALCULATE (
				DISTINCTCOUNT ( 'Fact_Offers'[location_country] ),
				TRIM ( 'Fact_Offers'[location_country] ) <> ""
			)
		formatString: #,##0
		lineageTag: 7a6a02c3-f652-4da8-8d8d-4fc9d3fc54b6

	measure 'Cities Hiring' =
			CALCULATE (
				DISTINCTCOUNT ( 'Fact_Offers'[location_city] ),
				TRIM ( 'Fact_Offers'[location_city] ) <> ""
			)
		formatString: #,##0
		lineageTag: 06f63ca4-6d83-4d7d-913c-ba5d805cface

	measure 'Offers Last 7 Days' =
			VAR LastValid =
				CALCULATE ( MAX ( 'Fact_Offers'[posted_date] ) )
			RETURN
				CALCULATE (
					[Total Job Offers],
					'Fact_Offers'[posted_date] > LastValid - 7
				)
		formatString: #,##0
		lineageTag: cb4f146d-03dd-44ba-8264-31c12b6452de

	measure 'Offers Last 30 Days' =
			VAR LastValid =
				CALCULATE ( MAX ( 'Fact_Offers'[posted_date] ) )
			RETURN
				CALCULATE (
					[Total Job Offers],
					'Fact_Offers'[posted_date] > LastValid - 30
				)
		formatString: #,##0
		lineageTag: 2d2a8941-ca77-4b94-b859-771e2b5317c6

	measure 'Last Posting Date' = CALCULATE ( MAX ( 'Fact_Offers'[posted_date] ))
		formatString: yyyy-MM-dd
		lineageTag: c9ac53ee-02b0-4d88-9059-8cff95a7e11f

	measure 'Remote Offers' = CALCULATE ( [Total Job Offers], 'Fact_Offers'[WorkModeBucket] = "Remote" )
		formatString: #,##0
		lineageTag: 852cbf2d-07ac-46a5-aa3c-ac6d4290ff51

	measure 'Hybrid Offers' = CALCULATE ( [Total Job Offers], 'Fact_Offers'[WorkModeBucket] = "Hybrid" )
		formatString: #,##0
		lineageTag: b01a8908-601b-4687-bb40-c4ef32b6ad82

	measure 'Remote Share' = DIVIDE ( [Remote Offers], [Total Job Offers] )
		formatString: 0.0%
		lineageTag: 5132b35a-3d12-461f-8114-3bf2cf0de1b6

	measure 'Hybrid Share' = DIVIDE ( [Hybrid Offers], [Total Job Offers] )
		formatString: 0.0%
		lineageTag: 1bd065d8-df67-4afa-8eb7-94ed3d047294

	measure 'On-site Share' =
			DIVIDE (
				CALCULATE ( [Total Job Offers], 'Fact_Offers'[WorkModeBucket] = "On-site" ),
				[Total Job Offers]
			)
		formatString: 0.0%
		lineageTag: e79fcf76-ccaa-49e2-a386-bca7244cca16

	measure 'Remote-Friendly Share' = DIVIDE ( [Remote Offers] + [Hybrid Offers], [Total Job Offers] )
		formatString: 0.0%
		lineageTag: bc5825fb-3709-4da5-9de3-69d6404edb61

	measure 'Offers By Skill With Salary' =
			CALCULATE (
				[Skill Demand],
				'Fact_Offers'[SalaryMidAnnual_EUR] > 0,
				'Fact_Offers'[SalaryMidAnnual_EUR] <= 1000000,
