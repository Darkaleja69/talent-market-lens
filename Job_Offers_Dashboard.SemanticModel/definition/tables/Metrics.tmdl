	/// Color por feature del mapa: gradiente azul por numero de ofertas dentro del ambito, transparente fuera de el. Sin seleccion se muestra Europa.
	measure 'Geo - Map Color' =
			VAR Sel = SELECTEDVALUE ( 'Geo Selection'[Selection] )
			VAR ActiveScope = IF ( ISFILTERED ( 'Geo Selection'[Selection] ), Sel, "Europe" )
			VAR Scp = SELECTEDVALUE ( 'MapFeature'[Scope] )
			VAR Reg = SELECTEDVALUE ( 'MapFeature'[Region] )
			VAR IsFrame = NOT ISBLANK ( Reg ) && LEFT ( Reg, 7 ) = "__Frame"
			VAR InScope = NOT ISBLANK ( ActiveScope ) && ActiveScope = Scp
			VAR V = [Geo - Map Value]
			VAR MaxV = MAXX ( ALLSELECTED ( 'MapFeature' ), [Geo - Map Value] )
			VAR Ratio = IF ( MaxV > 0, DIVIDE ( V, MaxV ), 0 )
			VAR R = INT ( 168 + ( 30 - 168 ) * Ratio )
			VAR G = INT ( 196 + ( 66 - 196 ) * Ratio )
			VAR B = INT ( 240 + ( 159 - 240 ) * Ratio )
			VAR HexChars = "0123456789ABCDEF"
			VAR Hex =
				"#" &
				MID ( HexChars, QUOTIENT ( R, 16 ) + 1, 1 ) & MID ( HexChars, MOD ( R, 16 ) + 1, 1 ) &
				MID ( HexChars, QUOTIENT ( G, 16 ) + 1, 1 ) & MID ( HexChars, MOD ( G, 16 ) + 1, 1 ) &
				MID ( HexChars, QUOTIENT ( B, 16 ) + 1, 1 ) & MID ( HexChars, MOD ( B, 16 ) + 1, 1 )
			RETURN
				IF (
					IsFrame || NOT InScope,
					"rgba(0,0,0,0)",
					IF ( V <= 0, "#94A3B8", Hex )
				)
		formatString: @
		lineageTag: fb345678-9012-cdef-a123-456789abcdef

	/// Filtro de visibilidad del Shape Map: solo mantiene las features del ambito seleccionado.
	measure 'Geo - Show Map Feature' =
			VAR Sel = SELECTEDVALUE ( 'Geo Selection'[Selection] )
			VAR ActiveScope = IF ( ISFILTERED ( 'Geo Selection'[Selection] ), Sel, "Europe" )
			VAR Scp = SELECTEDVALUE ( 'MapFeature'[Scope] )
			VAR Reg = SELECTEDVALUE ( 'MapFeature'[Region] )
			RETURN
				IF (
					NOT ISBLANK ( Reg ) && LEFT ( Reg, 7 ) = "__Frame",
					0,
					IF ( NOT ISBLANK ( ActiveScope ) && ActiveScope = Scp, 1, 0 )
				)
		formatString: 0
		lineageTag: 6f3c2b1a-9e8d-4c7b-a6f5-1234567890ab

	measure 'Offers With Salary' =
			CALCULATE (
				[Total Job Offers],
				'Fact_Offers'[SalaryMidAnnual_EUR] > 0,
				'Fact_Offers'[SalaryMidAnnual_EUR] <= 1000000,
				'Fact_Offers'[SalaryMinAnnual_EUR] <= 'Fact_Offers'[SalaryMaxAnnual_EUR]
			)
		formatString: #,##0
		lineageTag: d695cd4a-2527-403d-886e-0f905c696ffc

