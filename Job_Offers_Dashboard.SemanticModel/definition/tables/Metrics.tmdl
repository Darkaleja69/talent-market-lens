	/// Texto legible del filtro de país (oculto, usado por 'Selected Filters Text').
	measure 'FilterText País' = ```
			IF (
			    ISFILTERED ( 'Dim_Geo'[Country] ),
			    VAR V = VALUES ( 'Dim_Geo'[Country] )
			    VAR N = COUNTROWS ( V )
			    RETURN
			        "Country: " & 
			        //CONCATENATEX ( TOPN ( 3, V, 'Dim_Geo'[Country] ), 'Dim_Geo'[Country], ", " )
			        CONCATENATEX ( values ('Dim_Geo'[Country] ), 'Dim_Geo'[Country], ", " )
			        //& IF ( N > 3, " (+" & N - 3 & " more)", "" ),
			        ,
			    BLANK ()
			)
			```
		lineageTag: 1ee5c347-2ae6-4193-8411-367984c70957

