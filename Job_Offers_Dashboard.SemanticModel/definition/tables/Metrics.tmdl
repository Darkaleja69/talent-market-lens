	/// Ofertas por país para el mapa de fondo de Europa (usa el país de Dim_EuropeCountries).
	measure 'Geo - Country Offers' =
			CALCULATE (
			    [Total Job Offers],
			    'Fact_Offers'[GeoCountry] = MAX ( 'Dim_EuropeCountries'[Country] )
			)
		formatString: #,##0
		lineageTag: cae4519e-cfc8-411b-af50-dd20ec5ff1a2

	/// Ofertas por feature del mapa segun el ambito (Scope). MapFeature se relaciona con Fact_Offers a traves de MapFeatureBridge, por lo que la seleccion del mapa filtra el resto del informe.
	measure 'Geo - Map Value' =
			VAR S = SELECTEDVALUE ( 'MapFeature'[Scope] )
			VAR C = SELECTEDVALUE ( 'MapFeature'[Country] )
			VAR R = SELECTEDVALUE ( 'MapFeature'[Region] )
			VAR MapCountries = { "Spain", "Ireland", "Netherlands", "Switzerland" }
			VAR V =
				IF (
					S = "Europe",
					IF (
						R IN MapCountries,
						CALCULATE ( [Total Job Offers], 'Fact_Offers'[GeoCountry] = R ),
						0
					),
					CALCULATE ( [Total Job Offers], 'Fact_Offers'[GeoCountry] = C, 'Fact_Offers'[GeoRegion] = R )
				)
			RETURN
				COALESCE ( V, 0 )
		formatString: #,##0
		lineageTag: fa23df7d-f032-4607-98f8-2e6e9af006e4

	measure 'Last Update Time' = "Last Update: " & MAX(Last_Update[Last_Update])
