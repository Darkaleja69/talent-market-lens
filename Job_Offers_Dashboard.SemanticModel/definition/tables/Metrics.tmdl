	/// Número de ofertas que mencionan cada skill (coincidencia exacta por token, sin falsos positivos por subcadena).
	measure 'Skill Demand' = CALCULATE ( COUNTROWS ( 'Fact_OfferSkills' ), 'Dim_SkillList' )
		formatString: #,##0
		lineageTag: a0398b0d-ac40-42dc-9065-9feb45f92d36

	/// Porcentaje de ofertas que mencionan el skill sobre el total de ofertas del contexto.
	measure 'Skill Share' = DIVIDE ( [Skill Demand], CALCULATE ( [Total Job Offers], ALLSELECTED ( 'Fact_Offers' ), ALL ( 'Dim_SkillList' ) ) )
		formatString: 0.0%
		lineageTag: 5f0a7472-264d-40c6-8508-7c03f87412e3

	measure 'Skill Median Salary EUR' =
