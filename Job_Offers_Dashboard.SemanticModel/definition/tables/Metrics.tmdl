	/// Texto con todos los filtros seleccionados en el contexto actual, para mostrar junto al subtítulo.
	measure 'Selected Filters Text' =
			VAR Items =
			    FILTER (
			        {   [FilterText País],
			            [FilterText Región],
			            [FilterText Ciudad],
			            [FilterText Experiencia],
			            [FilterText Rol],
			            [FilterText Modalidad],
			            [FilterText Empleo],
			            [FilterText Empresa],
			            [FilterText Skill],
			            [FilterText Source],
			            [FilterText Salario Min],
			            [FilterText Salario Max]
			        },
			        NOT ISBLANK ( [Value] )
			    )
			VAR AllText =
			    CONCATENATEX ( Items, [Value], "   |   " )
			VAR MaxLen = 400
			RETURN
			    IF (
			        ISBLANK ( AllText ),
			        "No filters applied",
			        IF ( LEN ( AllText ) <= MaxLen, AllText, LEFT ( AllText, MaxLen ) & "…" )
			    )
		lineageTag: d842c54e-e8b6-438c-8b04-4fa1e977750d

	measure 'Show Offer' =
			
			VAR MinSeleccionado =
			    SELECTEDVALUE('Salary Min'[Salary Min], 0)
			VAR MaxSeleccionado =
			    SELECTEDVALUE('Salary Max'[Salary Max], 999999)
			VAR MinOferta =
			    MAX(Fact_Offers[SalaryMinAnnual_EUR])
			VAR MaxOferta =
			    MAX(Fact_Offers[SalaryMaxAnnual_EUR])
			RETURN
			    IF(
			        MinOferta > 0
			            && MaxOferta > 0
			            && MinOferta <= MaxOferta
			            && MaxOferta <= 1000000
			            && MaxOferta >= MinSeleccionado
			            && MinOferta <= MaxSeleccionado,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: eaeee577-2f8c-4cef-b6e8-8d4df83b5081

	measure 'Selected Country' = SELECTEDVALUE ( 'Geo Selection'[Selection], "All" )
		formatString: @
		lineageTag: f1234567-89ab-cdef-0123-456789abcdef

	measure 'Geo - Unmapped Regions' =
			CALCULATE (
				COUNTROWS ( Fact_Offers ),
				Fact_Offers[GeoRegion] = "(Other)"
			)
		formatString: #,##0
		lineageTag: ab123456-7890-abcd-ef12-3456789abcdef

	measure 'Geo - Unmapped Countries' =
			VAR Countries = { "Spain", "Ireland", "Netherlands", "Switzerland", "United States", "Europe" }
			RETURN
				CALCULATE (
					COUNTROWS ( Fact_Offers ),
					NOT ( Fact_Offers[GeoCountry] IN Countries )
				)
		formatString: #,##0
		lineageTag: cd234567-8901-bcde-f123-456789abcdef

	measure 'Geo - Coverage %' =
			VAR Total = COUNTROWS ( Fact_Offers )
			VAR Unmapped = [Geo - Unmapped Regions]
			RETURN
				DIVIDE ( Total - Unmapped, Total )
		formatString: 0.0%
		lineageTag: ef345678-9012-cdef-a123-456789abcdef

	/// Texto legible del filtro de scraper/fuente (oculto, usado por 'Selected Filters Text').
	measure 'FilterText Source' =
