				'Fact_Offers'[SalaryMidAnnual_EUR] <= 1000000,
				'Fact_Offers'[SalaryMinAnnual_EUR] <= 'Fact_Offers'[SalaryMaxAnnual_EUR]
			)
		formatString: #,##0
		lineageTag: 3f359c99-ce9f-4fe9-b37f-30c38295853b

