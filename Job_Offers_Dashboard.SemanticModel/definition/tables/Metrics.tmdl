	measure 'Selected Filters Text Salary_Insights' = ```
			
			 VAR Items =
			    FILTER (
			        {
			            [FilterText Geo],
			            [FilterText Región],
			            [FilterText Experiencia],
			            [FilterText Rol],
			            [FilterText Modalidad],
			            [FilterText Empleo],
			            [FilterText Empresa],
			            [FilterText Skill],
			            [FilterText Source],
			            [FilterText Salario Min],
			            [FilterText Salario Max]
			        },
			        NOT ISBLANK ( [Value] )
			    )
			VAR AllText =
			    CONCATENATEX ( Items, [Value], "   |   " )
			VAR MaxLen = 400
			RETURN
			    IF (
			        ISBLANK ( AllText ),
			        "No filters applied",
			        IF ( LEN ( AllText ) <= MaxLen, AllText, LEFT ( AllText, MaxLen ) & "…" )
			    )
			```
